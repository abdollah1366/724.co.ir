# این فایل را با نام .env کپی کنید و مقادیر را تغییر دهید. فایل .env هرگز نباید در گیت ثبت شود.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# برای PostgreSQL مقادیر زیر را پر کنید (در غیر این صورت SQLite استفاده می‌شود)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SITE_PHONE=
SITE_ADDRESS=
# روی سرور (deploy/install.sh این‌ها را خودش تنظیم می‌کند؛ راهنما: docs/DEPLOY.md)
# DJANGO_BEHIND_PROXY=true      # پشت Nginx: IP واقعی کاربر از X-Real-IP
# DJANGO_CACHE_BACKEND=db       # cache مشترک بین پردازه‌های Gunicorn
# DJANGO_ADMIN_URL=manage-xxxx/
# STATIC_ROOT= MEDIA_ROOT= PRIVATE_MEDIA_ROOT= BACKUP_DIR= LOG_DIR=
# هاست cPanel (deploy/cpanel/install.sh؛ راهنما: docs/HOSTING.md)
# MYSQL_DATABASE= MYSQL_USER= MYSQL_PASSWORD= MYSQL_HOST=localhost MYSQL_PORT=3306
# DJANGO_SERVE_STATIC=true DJANGO_SERVE_MEDIA=true   # بدون Nginx، خود برنامه فایل‌ها را سرو می‌کند
